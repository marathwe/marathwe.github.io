<div class="papers">
<% for (const item of items) { %>
<div class="paper" <%= metadataAttrs(item) %>>
<div class="paper-title"><%= item.title %></div>
<div class="paper-meta">
<% if (item.authors) { %><span class="paper-authors"><%= item.authors %></span><% } %>
<% if (item.venue) { %> · <span class="paper-venue"><%= item.venue %></span><% } %>
<% if (item.year) { %> · <span class="paper-year"><%= item.year %></span><% } %>
</div>
<% if (item.links && item.links.length) { %>
<div class="paper-links"><% for (const link of item.links) { %><a href="<%- link.url %>"><%= link.name %></a><% } %></div>
<% } %>
<% if (item.abstract) { %>
<details><summary>Abstract</summary><p><%= item.abstract %></p></details>
<% } %>
</div>
<% } %>
</div>
